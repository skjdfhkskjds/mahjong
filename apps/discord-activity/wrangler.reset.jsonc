{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahjong-discord-activity",
  "main": "tooling/reset-maintenance-worker.ts",
  "compatibility_date": "2026-08-23",
  "env": {
    "production": {
      "exports": {
        "ActivityInstance": {
          "type": "durable-object",
          "state": "deleted",
        },
        "TableRoom": {
          "type": "durable-object",
          "state": "deleted",
        },
      },
    },
  },
}
